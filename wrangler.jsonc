// Contact form API only. The website is on GitHub Pages (see .github/workflows/pages.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtualline-contact",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "virtualline35@gmail.com" }
  ],
  "routes": [
    { "pattern": "api.virtualine.co.uk", "custom_domain": true },
    { "pattern": "api.virtualline.co.uk", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
